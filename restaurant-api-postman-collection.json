    {
      "name": "Menu",
      "description": "API thực đơn mới gồm `categories` và `dishes`.",
      "item": [
        {
          "name": "Categories",
          "description": "API danh mục món ăn. `code` được backend tự sinh từ `name`.",
          "item": [
            {
              "name": "List Categories",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/categories",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiPrefix}}", "menu", "categories"]
                },
                "description": "Lấy danh sách category đang active."
              }
            },
            {
              "name": "Show Category",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/categories/{{categoryId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiPrefix}}", "menu", "categories", "{{categoryId}}"]
                },
                "description": "Lấy chi tiết category theo id. Response có `parent`, `children`, `dishes`."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const id = json?.metadata?.id;",
                      "if (id) pm.collectionVariables.set('categoryId', String(id));"
                    ]
                  }
                }
              ]
            },
