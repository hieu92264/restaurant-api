              "name": "Create Category",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"parent_id\": null,\n  \"name\": \"Món mới\",\n  \"description\": \"Danh mục món mới thêm vào menu\",\n  \"sort_order\": 10,\n  \"is_active\": true\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/categories",
