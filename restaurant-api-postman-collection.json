                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Món mới cập nhật\",\n  \"description\": \"Danh mục sau khi cập nhật\",\n  \"sort_order\": 11,\n  \"is_active\": true\n}",
