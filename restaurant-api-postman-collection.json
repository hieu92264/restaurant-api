{
  "info": {
    "_postman_id": "b065272b-f7b0-4a60-bba3-850a544f24a7",
    "name": "Restaurant API",
    "description": "Postman collection generated from uploaded Laravel API source. Base URL and token are stored as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "username",
      "value": "owner",
      "type": "string"
    },
    {
      "key": "password",
      "value": "12345678",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints using JWT guard (auth:api). Login/refresh scripts save access_token to collection variable accessToken.",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "auth",
                "login"
              ]
            },
            "description": "Login with username or email plus password. Only users with is_active = Y can authenticate."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) {}",
                  "const token = jsonData?.data?.access_token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('accessToken', token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "auth",
                "refresh"
              ]
            },
            "description": "Refresh JWT token. In this codebase, this endpoint is not explicitly protected by middleware, but JWT refresh usually expects the current bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) {}",
                  "const token = jsonData?.data?.access_token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('accessToken', token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "auth",
                "me"
              ]
            },
            "description": "Return current user profile, role, and permission tree. Requires bearer token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "auth",
                "logout"
              ]
            },
            "description": "Invalidate current JWT token. Requires bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    pm.collectionVariables.unset('accessToken');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "description": "User management endpoints under /users. All require bearer token. GET /users is limited to MANAGER, but OWNER bypasses all role checks in middleware. POST and DELETE currently use middleware role: with no explicit role list, so any authenticated role appears to pass.",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "users"
              ]
            },
            "description": "List users ordered by latest(). Requires auth:api and role MANAGER (OWNER also allowed by middleware)."
          },
          "response": []
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"newuser\",\n  \"full_name\": \"Nguyen Van A\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"12345678\",\n  \"role_id\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "users"
              ]
            },
            "description": "Create a user. Validation: user_name required unique, full_name required, email required unique, password min 8, role_id must exist."
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nguyen Van A Updated\",\n  \"email\": \"newuser.updated@example.com\",\n  \"password\": \"87654321\",\n  \"role_id\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Update user by ID. Any field is optional (sometimes validation). Route is protected by role MANAGER (OWNER also allowed)."
          },
          "response": []
        },
        {
          "name": "Delete User (Soft deactivate)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "users",
                "{{userId}}"
              ]
            },
            "description": "This endpoint does not hard delete. It sets is_active = 'N' for the target user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Default Laravel",
      "item": [
        {
          "name": "Current Sanctum User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "user"
              ]
            },
            "description": "Default Laravel route protected by auth:sanctum. This is separate from your JWT auth:api endpoints, so it may return 401 unless Sanctum is configured and used."
          },
          "response": []
        }
      ]
    }
  ]
}