        {
          "name": "Dishes",
          "description": "API món ăn. `code` tự sinh từ `name`. Nếu có ảnh, backend convert sang `.webp`.",
          "item": [
            {
              "name": "List Dishes",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/dishes",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiPrefix}}", "menu", "dishes"]
                },
                "description": "Lấy danh sách món ăn đang active."
              }
            },
            {
              "name": "Show Dish",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/dishes/{{dishId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiPrefix}}", "menu", "dishes", "{{dishId}}"]
                },
                "description": "Lấy chi tiết món ăn theo id."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const id = json?.metadata?.id;",
                      "if (id) pm.collectionVariables.set('dishId', String(id));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create Dish",
              "request": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "category_id", "value": "{{categoryId}}", "type": "text" },
                    { "key": "name", "value": "Cơm gà xối mỡ", "type": "text" },
                    { "key": "description", "value": "Cơm gà giòn, ăn kèm dưa leo và nước mắm gừng", "type": "text" },
                    { "key": "price", "value": "58000", "type": "text" },
                    { "key": "original_price", "value": "65000", "type": "text" },
                    { "key": "cost_price", "value": "28000", "type": "text" },
                    { "key": "unit", "value": "phan", "type": "text" },
                    { "key": "kitchen_name", "value": "Com ga", "type": "text" },
                    { "key": "is_featured", "value": "true", "type": "text" },
                    { "key": "is_new", "value": "true", "type": "text" },
                    { "key": "status", "value": "active", "type": "text" },
                    { "key": "available_from", "value": "06:00", "type": "text" },
                    { "key": "available_to", "value": "21:30", "type": "text" },
                    { "key": "sort_order", "value": "1", "type": "text" },
                    { "key": "options_json[]", "value": "{\"name\":\"Size\",\"type\":\"single\",\"options\":[{\"label\":\"Thường\",\"price_delta\":0},{\"label\":\"Lớn\",\"price_delta\":10000}]}", "type": "text" },
                    { "key": "tags_json[]", "value": "best_seller", "type": "text" },
                    { "key": "tags_json[]", "value": "new", "type": "text" }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/dishes",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiPrefix}}", "menu", "dishes"]
                },
                "description": "Tạo món ăn mới.\n\nGhi chú:\n- Dùng `form-data`\n- Không cần gửi `code`\n- Nếu thêm `image`, backend sẽ convert sang `.webp`\n\nVí dụ body chính:\n- `category_id`\n- `name`\n- `price`\n- `status`\n- `options_json[]`\n- `tags_json[]`\n"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const id = json?.metadata?.id;",
                      "if (id) pm.collectionVariables.set('dishId', String(id));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Update Dish",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "name", "value": "Cơm gà xối mỡ đặc biệt", "type": "text" },
                    { "key": "price", "value": "62000", "type": "text" },
                    { "key": "is_featured", "value": "true", "type": "text" },
                    { "key": "is_active", "value": "true", "type": "text" }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/dishes/{{dishId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiPrefix}}", "menu", "dishes", "{{dishId}}"]
                },
                "description": "Cập nhật món ăn. Có thể restore bằng `is_active = true`. Có thể gửi `image` mới để thay ảnh cũ."
              }
            },
            {
              "name": "Delete Dish",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/{{apiPrefix}}/menu/dishes/{{dishId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{apiPrefix}}", "menu", "dishes", "{{dishId}}"]
                },
                "description": "Ẩn món ăn bằng `is_active = false`."
              }
            }
          ]
        }
      ]
    }
  ]
}
